# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ── Node / Next.js ──────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/coverage
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# ── Python / Flask ──────────────────────────────────
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/

# ── Environment ─────────────────────────────────────
.env
.env.*

# ── OS / Editor ─────────────────────────────────────
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vercel
